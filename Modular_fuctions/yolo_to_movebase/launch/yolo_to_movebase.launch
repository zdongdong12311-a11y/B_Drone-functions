<launch>
  <!-- ================= 选择相机 =================
       camera:=down   只用朝下相机 (默认)
       camera:=front  只用朝前相机
       camera:=dual   双相机同时用 (需要 cameras_dual.yaml)
  ================================================ -->
  <arg name="camera" default="down"/>

  <!-- 根据 camera 自动选配置文件: cameras_<camera>.yaml -->
  <arg name="config"
       default="$(find yolo_to_movebase)/config/cameras_$(arg camera).yaml"/>

  <node pkg="yolo_to_movebase" type="yolo_to_movebase_node"
        name="yolo_to_movebase" output="screen">
    <rosparam command="load" file="$(arg config)"/>
  </node>
</launch>