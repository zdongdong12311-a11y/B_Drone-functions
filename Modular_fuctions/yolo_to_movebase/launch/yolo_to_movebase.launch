<launch>
  <arg name="camera" default="down"/>
  <arg name="config" default="$(find yolo_to_movebase)/config/cameras_$(arg camera).yaml"/>

  <!-- 上游 YOLO 话题：留空 = 用 yaml 默认 -->
  <arg name="down_topic"  default=""/>
  <arg name="front_topic" default=""/>

  <!-- 里程计话题：留空 = 用源码里的默认值 -->
  <arg name="odom_topic"  default=""/>

  <node pkg="yolo_to_movebase" type="yolo_to_movebase_node" name="yolo_to_movebase" output="screen">
    <rosparam command="load" file="$(arg config)"/>

    <param if="$(eval arg('down_topic') != '')"  name="down/topic"  value="$(arg down_topic)"/>
    <param if="$(eval arg('front_topic') != '')" name="front/topic" value="$(arg front_topic)"/>
    <param if="$(eval arg('odom_topic') != '')"  name="odom_topic"  value="$(arg odom_topic)"/>
  </node>
</launch>
