<?xml version="1.0"?>
<!--
  ROS Noetic URDF for:
    - 机架底板 (base_plate.stl)
    - 飞机腿 x4 (landing_leg.stl)
    - PX4 flight controller (box)
    - Livox MID-360 (cylinder approximation)

  TF tree produced by this URDF + robot_state_publisher:

      camera_init                 (FAST-LIO world, published by FAST-LIO)
      └── body                    (MID-360 internal IMU, FAST-LIO "body")
          ├── lidar_link          (MID-360 LiDAR frame)
          └── base_link           (PX4/FC body frame, FLU)
              ├── flight_controller
              ├── px4_imu_link
              ├── px4_frd
              ├── base_plate
              │   ├── landing_leg_front_left
              │   ├── landing_leg_front_right
              │   ├── landing_leg_rear_right
              │   └── landing_leg_rear_left
              └── base_footprint  (ground, leaf frame)

  Important:
    * `body` is the MID-360 internal IMU frame used by FAST-LIO.
    * `base_link` is at the PX4 flight-controller centre, FLU axes.
    * The MID-360 official IMU->LiDAR extrinsic is used:
          lidar_link xyz = [-0.011, -0.02329, 0.04412]
          lidar_link rpy = [0, 0, 0]
    * `body -> base_link` is assumed to be 0.02 m vertically (MID-360 IMU is
      2 cm above the FC centre). Adjust this if your mount is different.
    * `livox_frame` (published by the Livox driver) is connected to
      `lidar_link` by a static transform in real_robot.launch.
-->
<robot name="mid360_px4_drone">

  <!-- ===================== materials ===================== -->
  <material name="carbon_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="aluminium">
    <color rgba="0.65 0.65 0.65 1.0"/>
  </material>
  <material name="flight_controller_blue">
    <color rgba="0.10 0.30 0.75 1.0"/>
  </material>
  <material name="lidar_grey">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <!-- ===================== MID-360 IMU / FAST-LIO body ===================== -->
  <!--
    This is the root link of the robot description.
    FAST-LIO publishes camera_init -> body; robot_state_publisher publishes
    body -> base_link and body -> lidar_link.
  -->
  <link name="body"/>

  <!-- ===================== MID-360 LiDAR ===================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- approximate MID-360: 65 mm diameter x 60 mm high -->
        <cylinder radius="0.0325" length="0.06"/>
      </geometry>
      <material name="lidar_grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.0001692" ixy="0" ixz="0"
               iyy="0.0001692" iyz="0"
               izz="0.0001584"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="body"/>
    <child link="lidar_link"/>
    <!-- Official FAST-LIO MID-360 IMU->LiDAR extrinsic (LiDAR in IMU frame) -->
    <origin xyz="-0.011 -0.02329 0.04412" rpy="0 0 0"/>
  </joint>

  <!-- ===================== PX4 flight controller body ===================== -->
  <!--
    base_link is at the FC centre and uses FLU axes (x forward, y left, z up).
    If your MAVROS/PX4 frame is FRD, use the px4_frd frame below.
  -->
  <link name="base_link"/>

  <joint name="body_to_base_link_joint" type="fixed">
    <parent link="body"/>
    <child link="base_link"/>
    <!-- ADJUST: MID-360 IMU is assumed 0.02 m above the FC centre -->
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
  </joint>

  <!-- PX4 FC box -->
  <link name="flight_controller">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.06 0.02"/>
      </geometry>
      <material name="flight_controller_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.06 0.02"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0000333" ixy="0" ixz="0"
               iyy="0.0000708" iyz="0"
               izz="0.0000975"/>
    </inertial>
  </link>

  <joint name="flight_controller_joint" type="fixed">
    <parent link="base_link"/>
    <child link="flight_controller"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- PX4 IMU frame, coincident with the FC centre -->
  <link name="px4_imu_link"/>

  <joint name="px4_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="px4_imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Optional FRD frame for PX4-style consumers -->
  <link name="px4_frd"/>

  <joint name="px4_frd_joint" type="fixed">
    <parent link="base_link"/>
    <child link="px4_frd"/>
    <!-- FLU -> FRD: rotate 180 deg about X -->
    <origin xyz="0 0 0" rpy="3.14159265 0 0"/>
  </joint>

  <!-- ===================== base plate ===================== -->
  <link name="base_plate">
    <visual>
      <!-- STL is 362.2 x 362.2 x 3.5 mm; centre it at the link origin -->
      <origin xyz="-0.1811 -0.1811 -0.00175" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/base_plate.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="carbon_black"/>
    </visual>

    <collision>
      <origin xyz="-0.1811 -0.1811 -0.00175" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/base_plate.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.60"/>
      <inertia ixx="0.006560" ixy="0" ixz="0"
               iyy="0.006560" iyz="0"
               izz="0.013119"/>
    </inertial>
  </link>

  <joint name="base_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_plate"/>
    <!-- FC centre -> plate mid-plane: -0.01175 m -->
    <origin xyz="0 0 -0.01175" rpy="0 0 0"/>
  </joint>

  <!-- ===================== landing legs ===================== -->
  <!--
    One leg mesh is used four times.
    In the leg-link frame the round 4-hole flange is at the origin; the leg
    extends along +X and -Z.

    leg-link frame -> mesh visual:
      xyz = 0.087 -0.019 -0.402
      rpy = 1.5708 0 3.14159
  -->

  <!-- front-left: +X, +Y -->
  <link name="landing_leg_front_left">
    <visual>
      <origin xyz="0.087 -0.019 -0.402" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/landing_leg.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0.087 -0.019 -0.402" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/landing_leg.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0424 0 -0.20045" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.001073" ixy="0" ixz="0"
               iyy="0.001073" iyz="0"
               izz="0.00000144"/>
    </inertial>
  </link>

  <joint name="landing_leg_front_left_joint" type="fixed">
    <parent link="base_plate"/>
    <child link="landing_leg_front_left"/>
    <origin xyz="0.12 0.12 -0.00175" rpy="0 0 0.785398"/>
  </joint>

  <!-- front-right: +X, -Y -->
  <link name="landing_leg_front_right">
    <visual>
      <origin xyz="0.087 -0.019 -0.402" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/landing_leg.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0.087 -0.019 -0.402" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/landing_leg.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0424 0 -0.20045" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.001073" ixy="0" ixz="0"
               iyy="0.001073" iyz="0"
               izz="0.00000144"/>
    </inertial>
  </link>

  <joint name="landing_leg_front_right_joint" type="fixed">
    <parent link="base_plate"/>
    <child link="landing_leg_front_right"/>
    <origin xyz="0.12 -0.12 -0.00175" rpy="0 0 -0.785398"/>
  </joint>

  <!-- rear-right: -X, -Y -->
  <link name="landing_leg_rear_right">
    <visual>
      <origin xyz="0.087 -0.019 -0.402" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/landing_leg.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0.087 -0.019 -0.402" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/landing_leg.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0424 0 -0.20045" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.001073" ixy="0" ixz="0"
               iyy="0.001073" iyz="0"
               izz="0.00000144"/>
    </inertial>
  </link>

  <joint name="landing_leg_rear_right_joint" type="fixed">
    <parent link="base_plate"/>
    <child link="landing_leg_rear_right"/>
    <origin xyz="-0.12 -0.12 -0.00175" rpy="0 0 -2.356194"/>
  </joint>

  <!-- rear-left: -X, +Y -->
  <link name="landing_leg_rear_left">
    <visual>
      <origin xyz="0.087 -0.019 -0.402" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/landing_leg.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0.087 -0.019 -0.402" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/landing_leg.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0424 0 -0.20045" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.001073" ixy="0" ixz="0"
               iyy="0.001073" iyz="0"
               izz="0.00000144"/>
    </inertial>
  </link>

  <joint name="landing_leg_rear_left_joint" type="fixed">
    <parent link="base_plate"/>
    <child link="landing_leg_rear_left"/>
    <origin xyz="-0.12 0.12 -0.00175" rpy="0 0 2.356194"/>
  </joint>

  <!-- ===================== ground frame ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <!-- FC centre -> ground: 0.4155 m (with the current leg length) -->
    <origin xyz="0 0 -0.4155" rpy="0 0 0"/>
  </joint>

</robot>
